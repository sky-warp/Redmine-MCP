# Copy this file to .env.docker and fill in your own Redmine settings.
# Keep .env.docker local: it contains your credentials and is ignored by Git.

# Redmine must be reachable from inside the Docker container.
REDMINE_AUTH_MODE=legacy
REDMINE_URL=https://redmine.example.com
REDMINE_API_KEY=replace-with-your-api-key

# Listen inside the container. Compose exposes this port only on your computer.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Address used to generate attachment download links for local clients.
PUBLIC_HOST=localhost
PUBLIC_PORT=8000
ATTACHMENTS_DIR=/app/attachments

# Remove downloaded attachments after 60 minutes; check every 10 minutes.
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=10
ATTACHMENT_EXPIRES_MINUTES=60
